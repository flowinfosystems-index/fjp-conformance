# FJP-CONF static site — Railway deployment
#
# Serves:
#   /                    → FJP landing page
#   /success             → post-purchase thank you page
#   /conformance/v0.1/   → conformance spec page
#   /quickstart          → developer quickstart page
#   /abe                 → Abe (FJP Gate) developer page; /gate redirects here

{
	auto_https off
	admin off
}

:{$PORT} {
	root * /srv
	encode gzip

	@conformance_bare path /conformance /conformance/
	redir @conformance_bare /conformance/v0.1/ 302

	# /success serves the thank you page (try_files rewrites to the file)
	@success path /success /success/
	rewrite @success /success.html

	@quickstart path /quickstart /quickstart/
	rewrite @quickstart /quickstart.html

	@abe path /abe /abe/
	rewrite @abe /abe.html

	@gate path /gate /gate/
	redir @gate /abe 301

	# Spec lives in the abe repo; keep a stable URL for it.
	@abe_spec path /abe/spec /abe/spec/ /gate/spec /gate/spec/
	redir @abe_spec https://github.com/flowinfosystems-index/abe/blob/main/SPEC.md 302

	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
